<!-- 线性流程：卡片状态由 item.status 驱动，交互绑定 dataset.id -->
<navigation-bar title="流程" back="{{false}}" color="#3A3A3A" background="#FAF9F6">
  <button slot="left" class="nav-manage-btn" hover-class="nav-manage-btn--hover" bindtap="goManage">管理</button>
</navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="flow">
    <view class="flow-lead flow-lead--offset">
      <text class="flow-lead__kicker">晨间</text>
      <text class="flow-lead__title">{{pageTitle}}</text>
    </view>

    <view class="flow-banner" wx:if="{{flowCompleted}}">
      <text class="flow-banner__text">今日流程已完成</text>
      <button class="flow-btn flow-btn--ghost" bindtap="resetFlow">重新开始</button>
    </view>

    <view class="task-list">
    <block wx:for="{{tasks}}" wx:key="id">
      <view
        class="flow-card flow-card--{{item.status}}"
      >
        <view class="flow-card__row">
          <view class="flow-card__titles">
            <text class="flow-card__title">{{item.title}}</text>
            <text wx:if="{{item.desc}}" class="flow-card__desc">{{item.desc}}</text>
          </view>
          <view wx:if="{{item.status === 'finished'}}" class="flow-card__mark" aria-hidden="true"></view>
        </view>

        <view wx:if="{{item.status === 'locked'}}" class="flow-card__hint flow-card__hint--locked">未解锁</view>

        <view wx:if="{{item.status === 'active'}}" class="flow-card__actions">
          <button
            wx:if="{{item.type === 'default'}}"
            class="flow-btn"
            data-id="{{item.id}}"
            bindtap="onDefaultComplete"
          >
            完成
          </button>

          <button
            wx:if="{{item.type === 'timer'}}"
            class="flow-btn"
            data-id="{{item.id}}"
            bindtap="onTimerButtonTap"
            disabled="{{timerTicking && timerTaskId === item.id}}"
          >
            <block wx:if="{{timerTicking && timerTaskId === item.id}}">{{timerRemaining}} 秒</block>
            <block wx:else>开始 {{item.duration}} 秒</block>
          </button>

          <button
            wx:if="{{item.type === 'link'}}"
            class="flow-btn flow-btn--accent-alt"
            data-id="{{item.id}}"
            bindtap="onLinkTap"
          >
            前往小程序
          </button>
        </view>
      </view>
    </block>
    </view>
  </view>
</scroll-view>
